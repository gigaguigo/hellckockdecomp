			CurrentTarget = CurrentTargetReference.CurrentReference
		};
		_lastAimData = targetController.GetAimData(request);
		ITarget target = _lastAimData.AimTarget.Target;
		if (TimeManager.Instance.IsGameFrozen || CameraController.Instance.IsSupportCameraActive || GenericHUD.Instance.IsShowingCinematic)
		{
			target = null;
		}
		else if (!TargetLock.Free && CanTargetCurrentTarget)
		{
