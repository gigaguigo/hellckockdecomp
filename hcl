	public bool HasBetterGearEquipped(RuntimeGear gear)
	{
		RuntimeGear gear2 = GetGear(gear.GearDefinition.Slot);
		if (gear2 == null)
		{
			return false;
		}
		if (gear == gear2)
		{
			return true;
		}
		return gear2.IsBetterThan(gear);
