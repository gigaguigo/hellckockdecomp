			yield return new WaitForSecondsRealtime(interval);
			float timer = 0f;
			while (timer < fillDuration)
			{
				timer += Time.unscaledDeltaTime;
				float p = Mathf.Clamp01(timer / fillDuration);
				p = Easings.QuadraticEaseIn(p);
				_lineView.fillAmount = p;
				yield return null;
			}
		}
	}

