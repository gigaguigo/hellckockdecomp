	private void RebuildAvailableRewards()
	{
		_availableRewards.Clear();
		for (int num = _miraclesRewardCount.Count - 1; num >= 0; num--)
		{
			MiracleRewardInfo miracleRewardInfo = _miraclesRewardCount[num];
			Weighted<MiraclesRewardConfig> weightedReward = miracleRewardInfo.WeightedReward;
			if (weightedReward.Value.MaxAmount <= miracleRewardInfo.Amount)
			{
				_miraclesRewardCount.RemoveAt(num);
			}
			else if (weightedReward.Value.ConditionGroups.AllConditionsMet())
			{
				_availableRewards.Add(weightedReward);
			}
		}
	}

