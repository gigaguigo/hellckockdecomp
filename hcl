		{
			RemoveEnemyFromRegion(value, value2, enemy);
		}
		if (!_ignoreLevelClear && Enemies.Count - OptionalEnemies.Count == 0)
		{
			_ignoreLevelClear = true;
			KillAllEnemies(null, ignoreDrops: true);
