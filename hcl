	private void RefreshDuration()
	{
		_realDuration = _duration + Random.Range(0f - _durationRandomness, _durationRandomness);
	}

	public void AddToQueue(ItemBox box)
	{
		_queue.Enqueue(box);
	}

	public void Dispose()
	{
		_queue.Clear();
		GenericPool<Queue<ItemBox>>.Release(_queue);
	}

	public void Tick(float dt)
	{
		_timer += dt;
	}

	public bool CanDropNext()
	{
		return IsTimerCompleted();
	}

	public bool IsTimerCompleted()
	{
		return _timer >= _realDuration;
	}

	public bool IsEmpty()
	{
		return !IsBusy();
	}

	public bool IsBusy()
	{
		if (_queue.Count <= 0)
		{
			if (_realDuration > 0f)
			{
				return !IsTimerCompleted();
			}
			return false;
		}
		return true;
	}

	public ItemBox GetNextItem()
	{
		return _queue.Dequeue();
	}

	public void ResetTimer()
	{
		_timer = 0f;
		RefreshDuration();
	}
