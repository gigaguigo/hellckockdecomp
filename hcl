	private ETryCraftResult TryUseCraftingTool(CraftingToolSlot toolSlot, RelicInventoryItem item, params RelicInventoryItemRenderer[] renderers)
	{
		if (toolSlot == null || toolSlot.CurrencyDefinition == null || item == null)
		{
			return ETryCraftResult.ERROR;
		}
		CurrencyDefinition currencyDefinition = toolSlot.CurrencyDefinition;
		ETryCraftResult result;
		if (currencyDefinition.CanBeAppliedTo(item))
		{
			AudioController.Instance.PlaySfx(currencyDefinition.CurrencyApplySfx);
			CurrencyInventory currencyInventory = ClassSingleton<PlayerManager>.Instance.PlayerController.CurrencyInventory;
			RelicApplyDiff? diffReference = ClassSingleton<CurrencyController>.Instance.ApplyCurrencyAndGetDiff(item, currencyDefinition);
			currencyInventory.Use(currencyDefinition);
			result = ((currencyInventory.GetData(currencyDefinition).Amount > 0) ? ETryCraftResult.CRAFTED_REPEAT : ETryCraftResult.CRAFTED);
			RelicInventoryItemRenderer[] array = renderers;
			foreach (RelicInventoryItemRenderer relicInventoryItemRenderer in array)
			{
				if (!(relicInventoryItemRenderer == null))
				{
					relicInventoryItemRenderer.UpdateVisuals();
					relicInventoryItemRenderer.PlayUpgradeAnimation();
				}
			}
			ClassSingleton<CurrencyController>.Instance.PlayDiffAnimations(item, RelicTooltip.Instance, ref diffReference);
		}
		else
		{
			AudioController.Instance.PlaySfx(_applyCurrencyError);
			RelicInventoryItemRenderer[] array = renderers;
			foreach (RelicInventoryItemRenderer relicInventoryItemRenderer2 in array)
			{
				if (!(relicInventoryItemRenderer2 == null))
				{
					relicInventoryItemRenderer2.PlayErrorAnimation();
				}
			}
			result = ETryCraftResult.CANT_CRAFT;
		}
		return result;
	}

