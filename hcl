	protected override void SetupWindow()
	{
		base.SetupWindow();
		_characterView.Setup(PlayerController);
		if (!PlatformInfo.IsMobile)
		{
			GenericHUD.Instance.JoinContext(_joystickContext, _runtimeHudRegion);
		}
		if (!_firstSetup)
		{
			MiddleRightAnchor.anchoredPosition -= Vector2.right * -760f;
			_firstSetup = true;
		}
	}

	private void Update()
	{
		if ((WindowController.Instance.IsShowingScreen(EScreen.BLESSING_SELECTION) || WindowController.Instance.IsShowingScreen(EScreen.GEAR_VARIANT_SWITCH_SCREEN)) && GenericHUD.Instance.SkillBarView.IsDragging)
		{
			GenericHUD.Instance.SkillBarView.ForceCancelDrag();
		}
		if (_joystickContext.HasEntered && _characterView.PlayerInventoryView.gameObject.activeSelf)
		{
			PointerEventData eventData = new PointerEventData(EventSystem.current);
			_characterView.PlayerInventoryView.RelicPlayerInventory.Tick(eventData);
		}
	}

	public EPlayerInventoryTabType GetTabFromAction(EInputAction action)
	{
		EPlayerInventoryTabType result = EPlayerInventoryTabType.GEAR;
		switch (action)
		{
		case EInputAction.CharacterViewCharacter:
			result = EPlayerInventoryTabType.STATS;
			break;
		case EInputAction.CharacterViewRelics:
			result = EPlayerInventoryTabType.RELICS;
			break;
		case EInputAction.CharacterViewBlessings:
			result = EPlayerInventoryTabType.BLESSINGS;
			break;
