	private IEnumerator BounceTarget(ITarget sourceTarget, Vector3 castOffset)
	{
		for (int i = 0; i < BounceAmountModifier; i++)
		{
			ITarget closestTarget = FindClosestTarget(sourceTarget);
			if (closestTarget == null)
			{
