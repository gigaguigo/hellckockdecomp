	private void EnableVengeanceMode()
	{
		if (_vengeanceModeStatusDefinitionRef == null || _playerController == null)
		{
			return;
		}
		StatusDefinition reference = _vengeanceModeStatusDefinitionRef.Reference;
		if (reference == null)
		{
			return;
		}
		_currentVengeanceModeStatus = reference.Instantiate(null) as StatModifierStatusDefinition;
		if (_currentVengeanceModeStatus == null)
		{
			return;
		}
		foreach (VengeanceModeStatConfig vengeanceModeStatConfig in _vengeanceModeStatConfigs)
		{
			StatModifierDefinition statModifierDefinition = vengeanceModeStatConfig.StatModifierDefinition;
			float num = statModifierDefinition.Value + vengeanceModeStatConfig.IncrementPerRun * (float)PlayerSaveManager.CurrentPlayerData.vengeanceModeRunCount;
			if (vengeanceModeStatConfig.MaximumValue > 0f)
			{
				num = Math.Min(num, vengeanceModeStatConfig.MaximumValue);
			}
			_currentVengeanceModeStatus.OverridableValueList.OverrideValue(statModifierDefinition.EStatDefinition.ToString(), num);
		}
		_playerController.StatusController.AddStatus(_currentVengeanceModeStatus, _playerController, _playerController);
	}

