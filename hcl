		int count = list.Count;
		List<string> list2 = CollectionPool<List<string>, string>.Get();
		List<string> list3 = CollectionPool<List<string>, string>.Get();
		List<(int, int)> list4 = CollectionPool<List<(int, int)>, (int, int)>.Get();
		if (isOnAscension)
		{
			list2.Add("AscensionGameModeLabel");
			FillActs(list3, list4, list, isOnAscension, EWorldTier.Normal);
		}
		else
		{
			foreach (KeyValuePair<EWorldTier, WorldTierConfig> worldTierConfig in Constants.GameConfig.WorldTierConfigs)
			{
				if (worldTierConfig.Key != EWorldTier.Void)
				{
					list2.Add(worldTierConfig.Value.WorldTierLocalizationKey);
					FillActs(list3, list4, list, isOnAscension, worldTierConfig.Key);
				}
			}
		}
		CollectionPool<List<int>, int>.Release(list);
		return new CorruptedShrinePresentationData(count, list2, list3, list4);
	}

	private void FillActs(List<string> actLabelsToFill, List<(int, int)> actShrinesToFill, List<int> acts, bool isAscension, EWorldTier worldTier)
	{
		int num = 0;
		foreach (int act in acts)
		{
			DungeonConfig byID = DungeonConfig.GetByID((int)GameDifficultyController.GetDungeonByWorldTierAndAct(isAscension, worldTier, (EDungeon)act));
			int shrineAmount = byID.ShrineAmount;
			int claimedShrineAmount = byID.ClaimedShrineAmount;
			actLabelsToFill.Add(byID.ActLocalizationKey);
			actShrinesToFill.Add((claimedShrineAmount, shrineAmount));
			num += shrineAmount;
		}
	}

