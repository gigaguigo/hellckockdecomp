	public IEnumerator Play(float duration)
	{
		float timer = 0f;
		int lastIndexStroked = -1;
		string originalText = _description.text;
		while (timer < duration)
		{
			timer += Time.deltaTime;
			float num = Easings.QuadraticEaseOut(Mathf.Clamp01(timer / duration));
			int num2 = Mathf.RoundToInt((float)originalText.Length * num);
			if (lastIndexStroked != num2)
			{
				string text = originalText.Insert(0, "<s>");
				text = text.Insert(num2 + 3, "</s>");
				_description.text = text;
				lastIndexStroked = num2;
			}
			yield return null;
		}
	}

