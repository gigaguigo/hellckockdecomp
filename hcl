	private void FillMatchingToolSlots(CurrencyDefinition currency, List<CraftingToolSlot> slots)
	{
		if (_slots == null)
		{
			return;
		}
		for (int i = 0; i < _slots.Count; i++)
		{
			CraftingToolSlot craftingToolSlot = _slots[i];
			if (!(craftingToolSlot == null) && craftingToolSlot.HasSameConfig(currency))
			{
				slots.Add(craftingToolSlot);
			}
		}
		if (CurrentDraggedSlot != null && CurrentDraggedSlot.HasSameConfig(currency))
		{
			slots.Add(CurrentDraggedSlot);
		}
	}

