	public override async Awaitable<GameObject> InstantiateBasePrefab(Transform parent)
	{
		if (!_enemyPrefab.RuntimeKeyIsValid())
		{
			return null;
		}
		if (_enemyPrefab.Asset != null)
		{
			return _enemyPrefab.Asset as GameObject;
		}
		AsyncOperationHandle<GameObject> handler = _enemyPrefab.InstantiateAsync(parent);
		if (!handler.IsDone)
		{
			await handler.Task;
		}
		if (handler.Result == null || handler.Status != AsyncOperationStatus.Succeeded)
		{
			Debug.LogError($"Fail to load asset reference {handler.OperationException}");
			return null;
		}
		GameObject result = handler.Result;
		result.name = result.name.Remove("(Clone)");
		EnemyController component = result.GetComponent<EnemyController>();
		component.CharacterEffectsController.CreateEliteEffects(result.transform.localScale);
		component.SetupMinimapIcon();
		component.SetMinimapIcon(IconType.Enemy);
		RagdollController componentInChildren = result.GetComponentInChildren<RagdollController>();
		if (componentInChildren != null)
		{
			componentInChildren.DisableRagdoll();
		}
		return result;
	}
}

