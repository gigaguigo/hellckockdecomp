	private void FillComponents<T>(Transform target, out List<TransformAndHandler<T>> outList, ref List<TransformAndHandler<T>> refList)
	{
		outList = refList;
		if (target == null)
		{
			return;
		}
		Component[] components = target.GetComponents(typeof(T));
		foreach (Component component in components)
		{
			if (outList == null)
			{
				outList = new List<TransformAndHandler<T>>();
			}
			if ((!(typeof(T) != typeof(Button)) || !(component.GetType() == typeof(Button))) && !(component.GetType() == typeof(JoystickFocusPoint)) && (_toIgnore == null || !_toIgnore.Contains(target)))
			{
				outList.Add(new TransformAndHandler<T>(target, (T)(object)component));
			}
		}
		for (int j = 0; j < target.childCount; j++)
		{
			Transform child = target.GetChild(j);
			if (!(child == null))
			{
				FillComponents(child, out outList, ref refList);
			}
		}
	}

