		if (!GetUnlockedConstellations().Contains(content))
		{
			iconAndLabels = new List<DevotionAndCount>();
			constellationSkillTreeContent.ConstellationSkillTreeDefinition.FillDevotionsToUnlock(ref iconAndLabels);
			iconAndLabels.Sort();
		}
		List<DevotionAndCount> iconAndLabels2 = new List<DevotionAndCount>();
		constellationSkillTreeContent.ConstellationSkillTreeDefinition.FillMasteredDevotionGranted(ref iconAndLabels2);
		bool hasMastered = constellationSkillTreeContent.ConstellationSkillTreeController.GetConstellationState() == EConstellationState.Mastered;
		UniqueRelicInventoryItem manifestedRelic = null;
		int num = CachedManifestedAffixNodes.IndexOf(nodeView.SkillTreeNode);
		if (num != -1 && num < CachedManifestedRelics.Count)
		{
			manifestedRelic = CachedManifestedRelics[num];
		}
		ConstellationTooltipData result = new ConstellationTooltipData(constellationSkillTreeContent, nodeView2, nodeView.RectTransform, iconAndLabels2, hasMastered, iconAndLabels, manifestedRelic);
		result.PositioningData.Offset = new Vector2(0f, 25f);
		result.PositioningData.Spacing = 40f;
		result.PositioningData.PaddingTop = 180f;
		result.PositioningData.PaddingBottom = 160f;
		Vector3 vector = nodeView.transform.position - content.transform.position;
		result.PositioningData.Direction = ((vector.x > 0f) ? ETooltipDirection.FORWARD : ETooltipDirection.BACK);
		result.PositioningData.IgnoreScaling = true;
		if (OnboardingPanel.Instance.IsCurrentlyShowingOnboarding())
		{
			result.PositioningData.PaddingBottom = 320f;
		}
		return result;
	}

