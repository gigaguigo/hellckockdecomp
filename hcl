			sourceTarget = closestTarget;
		}
	}

	private ITarget GetPreferredTarget(IEnumerable<IDamageable> targetsInRadius)
	{
		WeightedList<IDamageable> weightedList = new WeightedList<IDamageable>();
		float time = Time.time;
		foreach (IDamageable item in targetsInRadius)
		{
			if (!TargetsSelectedByTime.TryGetValue(item, out var value))
			{
				value = 0f;
				TargetsSelectedByTime[item] = value;
			}
			weightedList.Add(new Weighted<IDamageable>(item, Mathf.Min(time - value, 2f)));
		}
		IDamageable randomValue = weightedList.GetRandomValue();
		TargetsSelectedByTime[randomValue] = time;
		return randomValue.GetTarget();
	}

