	private void SetupDevotion()
	{
		_devotionByCategory = new Dictionary<EDevotionCategory, ModifiableIntState>();
		foreach (EDevotionCategory value in Enum.GetValues(typeof(EDevotionCategory)))
		{
			ModifiableIntState modifiableIntState = new ModifiableIntState();
			_devotionByCategory.Add(value, modifiableIntState);
			modifiableIntState.ValueState.OnChange.Register(UpdateDevotionAggregators);
			DevotionAffinityModifierByCategory.Add(value, new ModifiableDoubleState(1.0));
		}
		UpdateDevotionAggregators();
	}

	public void UpdateDevotionAggregators()
	{
		ConstellationsConfig cONSTELLATIONS_CONFIG = Constants.CONSTELLATIONS_CONFIG;
		_dropModifierByDevotion.Clear();
		HighestDevotionCategories.Clear();
		int num = 1;
		foreach (EDevotionCategory value in Enum.GetValues(typeof(EDevotionCategory)))
		{
			int num2 = (int)DevotionAffinityModifierByCategory[value].CalculateModifiedValue(GetDevotion(value).Value);
			_dropModifierByDevotion[value] = cONSTELLATIONS_CONFIG.GetDevotionDropModifierForPoints(value, num2);
			if (num2 > num)
			{
				num = num2;
				HighestDevotionCategories.Clear();
				HighestDevotionCategories.Add(value);
			}
			else if (num2 == num)
			{
				HighestDevotionCategories.Add(value);
			}
		}
	}

	public float GetDevotionBonusModifier(EDevotionCategory[] devotionAffinity)
	{
		if (devotionAffinity.Length == 1)
		{
			return _dropModifierByDevotion.GetValueOrDefault(devotionAffinity[0], 1f);
		}
		return (from pair in _dropModifierByDevotion
			where devotionAffinity.Contains(pair.Key)
			orderby pair.Value descending
			select pair).FirstOrDefault().Value;
	}

	private void SetupConstellations(PlayerController playerController)
	{
		List<SkillTreeData> skillTreesData = _constellationsData.skillTreesData;
		List<HsoRef<ConstellationSkillTreeDefinition>> constellations = Constants.CONSTELLATIONS_CONFIG.Constellations;
		_nodesByIdentifier.Clear();
		foreach (HsoRef<ConstellationSkillTreeDefinition> item in constellations)
		{
			ConstellationSkillTreeDefinition skillTreeDefinition = item.Reference;
			SkillTreeData skillTreeData = skillTreesData.Find((SkillTreeData target) => target.SkillTreeHashId == skillTreeDefinition.HashID);
			if (skillTreeData == null)
			{
				skillTreeData = new SkillTreeData(skillTreeDefinition.HashID);
				skillTreesData.Add(skillTreeData);
			}
			ConstellationSkillTreeController constellationSkillTreeController = new ConstellationSkillTreeController(playerController, skillTreeData);
			constellationSkillTreeController.OnUpdateData.Register(UpdateData);
			_skillTreeControllerByHashId.Add(skillTreeDefinition.HashID, constellationSkillTreeController);
			foreach (SkillTreeNode skillTreeNode in skillTreeData.SkillTreeNodes)
			{
				if (!_nodesByIdentifier.TryAdd(skillTreeNode.Identifier, skillTreeNode))
				{
					Debug.LogError("[ConstellationsController]: Failed to add node with guid " + skillTreeNode.Identifier);
				}
			}
		}
		UpdateData();
	}

