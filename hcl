	private void SimulateRelicMovements(float dt)
	{
		for (int num = RelicMovements.Count - 1; num >= 0; num--)
		{
			RelicMovement value = RelicMovements[num];
			if (value.Tick(dt, CurrentPage))
			{
				RelicMovements.RemoveAt(num);
			}
			else
			{
				RelicMovements[num] = value;
			}
		}
	}

