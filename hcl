	{
		Vector3 a = ((from == null) ? _notificationBillboard.position : from.HeadAnchor.position);
		_notificationBillboard.position = Vector3.Lerp(a, to.HeadAnchor.position, Easings.ExponentialEaseOut(ratio));
	}

