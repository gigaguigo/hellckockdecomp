	public RuntimeGear UnequipGear(EGearSlot slot)
	{
		_gear.TryGetValue(slot, out var value);
		if (value != null)
		{
			value.RemoveStatModifiers(PlayerController, Key);
			_onUnequipGear.Trigger(value);
		}
		_gear[slot] = null;
		return value;
	}

