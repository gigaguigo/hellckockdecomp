			yield return MarkTarget(closestTarget, sourceTarget.GetPosition());
			IEnemy item = ((DamageableTarget)(object)sourceTarget).Damageable as IEnemy;
			if (!ThrowKnife(castOffset, closestTarget, sourceTarget.Transform, new List<IDamageable> { item }))
