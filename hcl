	private ExternalInventorySaveData CombineInventoryData(RelicExternalInventoryManager relicExternalInventory, RelicPlayerInventoryManager playerInventory)
	{
		ExternalInventorySaveData externalInventorySaveData = new ExternalInventorySaveData
		{
			ItemPages = relicExternalInventory.Data.ItemPages.ToList()
		};
		List<ExternalInventoryPageData> itemPages = externalInventorySaveData.ItemPages;
		for (int num = itemPages.Count - 1; num >= 0; num--)
		{
			ExternalInventoryPageData externalInventoryPageData = itemPages[num];
			List<RelicInventoryItem> list = externalInventoryPageData.Items.FindAll((RelicInventoryItem item) => !item.Ascended);
			if (list.Count > 0)
			{
				externalInventoryPageData.Items = list;
				itemPages[num] = externalInventoryPageData;
			}
			else
			{
				itemPages.RemoveAt(num);
			}
		}
		if (itemPages.Count == 0)
		{
			itemPages.Add(new ExternalInventoryPageData
			{
				Items = new List<RelicInventoryItem>()
			});
		}
		externalInventorySaveData.ItemPages = itemPages;
		return externalInventorySaveData;
	}

