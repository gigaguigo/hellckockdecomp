	public void GoToNextStep(bool isFirst)
	{
		if (!isFirst)
		{
			AudioController.Instance.PlaySfx(_nextStepSfx);
		}
		_currentStep++;
		List<OnboardingSpotlightStepData> stepsData = _currentOnboardingSpotlightData.StepsData;
		if (_currentStep > stepsData.Count)
		{
			Dismiss();
			return;
		}
		NextStepValidator.Void();
		_onNextStep?.Invoke(_currentOnboardingSpotlightData.Key, _currentStep - 1);
		OnboardingSpotlightStepData currentStepData = stepsData[_currentStep - 1];
		InputHandler.Instance.IsUsingPhysicalJoystick.OnChange.RegisterValidated(NextStepValidator, UpdateLocalization);
		UpdateLocalization();
		_canvasGroup.alpha = 0f;
		_canvasGroup.DOFade(1f, _fadeInTime).SetUpdate(isIndependentUpdate: true);
		if (_currentStep == stepsData.Count)
		{
			_currentOnboardingSpotlightData.MarkAsCompleted();
		}
		if (currentStepData.OnboardingSpotlightBehavior.HasFlag(EOnboardingSpotlightBehavior.WaitForNextButton))
		{
			RegisterToNextTutorialAction(currentStepData.HasDelay);
		}
		if (currentStepData.OnboardingSpotlightBehavior.HasFlag(EOnboardingSpotlightBehavior.WaitForSpecific))
		{
			AddNextStepSpecificBehaviourListener(currentStepData);
		}
		if (currentStepData.OnboardingSpotlightBehavior.HasFlag(EOnboardingSpotlightBehavior.Automatically))
		{
			ScheduleAutomaticNextStep(currentStepData.TimeToGoToNextStep);
		}
		if (currentStepData.OnboardingSpotlightBehavior.HasFlag(EOnboardingSpotlightBehavior.WaitForFlag))
		{
			PlayerSaveManager.Instance.PlayerSaveData.OnAddFlag.RegisterValidated(NextStepValidator, (string x) =>
			{
				OnAddFlag(x, currentStepData.FlagName);
			});
		}
		Reposition();
		bool active = currentStepData.OnboardingSpotlightBehavior == EOnboardingSpotlightBehavior.WaitForNextButton || currentStepData.OnboardingSpotlightBehavior == EOnboardingSpotlightBehavior.ManualDismiss;
		_keyContainer.gameObject.SetActive(active);
		LayoutRebuilder.ForceRebuildLayoutImmediate(_keyContainer);
		_descriptionTextGlyphTextFormatter.SetFormattedText(_descriptionText.text);
		_descriptionText.ForceMeshUpdate();
		LayoutRebuilder.ForceRebuildLayoutImmediate(_content);
		LayoutRebuilder.ForceRebuildLayoutImmediate((RectTransform)transform);
		if (!currentStepData.OnboardingSpotlightBehavior.HasFlag(EOnboardingSpotlightBehavior.WaitForNextButton))
		{
			_context.PopOut();
		}
		_onRequiredSkillHighlightChange.Trigger(currentStepData.SkillToHighlight);
		_onPostNextStep?.Invoke();
	}

	private void UpdateLocalization()
	{
		if (_currentOnboardingSpotlightData != null)
		{
			List<OnboardingSpotlightStepData> stepsData = _currentOnboardingSpotlightData.StepsData;
			if (_currentStep <= stepsData.Count)
			{
				_titleText.SetLocalizedText(string.Empty);
				_descriptionText.SetLocalizedText(string.Empty);
				OnboardingSpotlightStepData onboardingSpotlightStepData = stepsData[_currentStep - 1];
				_titleText.SetLocalizedText(_currentOnboardingSpotlightData.TitleLocalizationKey);
				_descriptionText.SetLocalizedText(onboardingSpotlightStepData.DescriptionLocalizationKey);
				_stepText.SetLocalizedText(string.Format("{0}&<{1}&<{2}", "StepTotalLabel", _currentStep, stepsData.Count));
			}
		}
	}

