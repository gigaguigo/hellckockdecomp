	public void Update()
	{
		if (_isMouseDown)
		{
			Vector3 inputPosition = GetInputPosition();
			Vector2 screenUIPos = GetScreenUIPos(inputPosition);
			Stick.anchoredPosition = screenUIPos;
			Vector2 vector = screenUIPos - Background.anchoredPosition;
			float magnitude = vector.magnitude;
			Vector2 normalized = vector.normalized;
			if (magnitude > StickRadius)
			{
				Background.anchoredPosition = screenUIPos - normalized * StickRadius;
			}
			StickBgRotator.eulerAngles = new Vector3(0f, 0f, Mathf.Atan2(0f - normalized.x, normalized.y) * 57.29578f);
			float y = Mathf.Lerp(1f, 2.31f, magnitude / StickRadius);
			StickBgPivot.localScale = new Vector3(1f, y, 1f);
			if (magnitude < DeadZone)
			{
				_isHoldingStill.Value = true;
				_movement.Value = Vector2.zero;
			}
			else
			{
				_isHoldingStill.Value = false;
				_movement.Value = normalized;
			}
		}
	}

	private Vector3 GetInputPosition()
	{
		Vector3 mousePosition = Input.mousePosition;
