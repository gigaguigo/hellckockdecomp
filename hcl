	public void Collect(Prize prize)
	{
		if (prize.IsGold)
		{
			AddGold(prize.Amount);
		}
		else if (prize.IsPotion)
		{
			PlayerController.Instance.PotionController.PickupPotion();
		}
		else if (prize.IsSoulStones)
		{
			PlayerController.Instance.PlayerSheet.AddSoulStones((uint)prize.Amount);
		}
		else if (prize.IsHellClockTime)
		{
			TimerManager.Instance.IncrementTimer((uint)prize.Amount);
		}
		else if (prize.IsRelic)
		{
			PlayerController.Instance.CollectRelic(prize.RelicInventoryItem);
		}
		else if (prize.IsGear)
		{
			RuntimeGear gear = prize.Gear;
			ClassSingleton<GearController>.Instance.CollectGearFromGround(gear);
		}
		else
		{
			if (!prize.IsCurrency)
			{
				Debug.Log("Can't collect. Unknown type");
				return;
			}
			_currencyInventory.CollectCurrency(prize);
		}
		_onCollectPrizeEvent?.Trigger(prize);
	}

