	{
		IsDisabled = false;
		gameObject.SetActive(value: true);
		BlessingCard currentCard;
		if (rolledBlessingEffect is RelicTreasureBlessingEffect)
		{
			currentCard = _relicBlessingCard;
		}
		else if (rolledBlessingEffect is GearTreasureBlessingEffect)
		{
			currentCard = _gearBlessingCard;
		}
		else if (rolledBlessingEffect is SkillDeckBlessingEffect skillDeckBlessingEffect)
		{
			if (skillDeckBlessingEffect.IsRelicAffixSkillBlessing)
			{
				currentCard = _relicAffixSkillBlessingCard;
			}
			else
			{
				currentCard = (skillDeckBlessingEffect.IsProxySkillBlessing ? _relicBlessingCard : _baseBlessingCard);
			}
		}
		else if (rolledBlessingEffect is NightmareThemeBlessingEffect)
		{
			currentCard = _nightmareThemeBlessingCard;
		}
		else if (rolledBlessingEffect is NightmareBlessingEffect)
		{
			currentCard = _nightmareRollBlessingCard;
		}
		else
		{
			currentCard = ((!(rolledBlessingEffect is MiracleBlessingEffect)) ? _baseBlessingCard : _miracleBlessingCard);
		}
		CurrentCard = currentCard;
		((RectTransform)transform).SetSizeWithCurrentAnchors(RectTransform.Axis.Horizontal, ((RectTransform)CurrentCard.transform).rect.width);
		CurrentCard.Button.DoStateTransitionManually(ManualSelectionState.Normal, instant: true);
		foreach (BlessingCard card in Cards)
		{
			if (card != CurrentCard)
			{
				card.Disable();
			}
		}
		CurrentCard.Setup(rolledBlessingEffect, nextInstanceIsFree, defaultGoldColor, notEnoughGoldColor, blessingRollGroupInstance);
	}

