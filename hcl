			_movement.Value = Vector3.zero;
			_isMouseDown = false;
			_isHoldingStill.Value = false;
			CanvasGroup.DOKill();
			CanvasGroup.DOFade(0f, 0.5f).OnComplete(GoToDefaultPosition);
		}
