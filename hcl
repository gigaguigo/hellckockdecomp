	private bool UpdateStatusOrbs(StatusDefinition statusDefinition, List<CharacterOrb> orbs)
	{
		int num = _characterController.StatusController.GetStacksOrInstancesAmount(statusDefinition) - orbs.Count;
		if (num == 0)
		{
			return false;
		}
		if (num > 0)
