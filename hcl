	{
		BlessingRowsContainer value;
		if (!(effect is SkillDeckBlessingEffect skillDeckBlessingEffect))
		{
			UnityEngine.Debug.LogError("Blessing effect categorized as Skill blessing is not SkillBlessingDefinition: " + effect.TitleLocalizationKey);
		}
		else if (_blessingsViewBySkill.TryGetValue(skillDeckBlessingEffect.SourceSkill, out value))
		{
			value.AddBlessingEffect(effect);
		}
	}

