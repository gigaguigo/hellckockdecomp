	{
		_statBlessings.CreateBlessingsIcons();
		foreach (BlessingRowsContainer value in _blessingsViewBySkill.Values)
		{
			value.CreateBlessingsIcons();
		}
		LayoutRebuilder.ForceRebuildLayoutImmediate(_mainContentParent);
		LayoutRebuilder.ForceRebuildLayoutImmediate(_skillBlessingsParent);
	}
}

