	private IEnumerator LoadLevel(LevelInfo levelInfo, Action afterFadeOut, Func<Coroutine> beforeFadeIn)
	{
		CheatInputs.CanChangeLevel.BlockButDoNotIncrease(this);
		TimerManager.Instance.PauseTimer.Block(this);
		IsChangingLevel.SetTrue();
		yield return FadeOut();
		IsBlockingEnabledEvents.Setter(value: true);
		afterFadeOut?.Invoke();
		HasFadedOut.Trigger();
		PlayerController.Instance.DisableInteractions();
		LevelInfo currentLevel = _currentLevel;
		if (currentLevel != null && currentLevel.SceneReference.ScenePath != levelInfo.SceneReference.ScenePath)
		{
			yield return InnerUnloadLevelScene(currentLevel.SceneReference);
			yield return Resources.UnloadUnusedAssets();
		}
		yield return InnerLoadLevel(levelInfo.SceneReference);
		for (int i = 0; i < 10; i++)
		{
			yield return null;
		}
		SetRootObjectsState(levelInfo.SceneReference, activate: true);
		yield return null;
		LevelObjects levelObjects = UnityEngine.Object.FindObjectOfType<LevelObjects>();
		MinimapMesh minimapMesh = UnityEngine.Object.FindObjectOfType<MinimapMesh>();
		levelInfo.LevelObjects = levelObjects;
		levelInfo.MinimapMesh = minimapMesh;
		levelObjects.SetupLevel(levelInfo);
		yield return beforeFadeIn?.Invoke();
		IsBlockingEnabledEvents.Setter(value: false);
		if (!_ignoreAutoFadeOut)
		{
			GenericHUD.Instance.HideBlackScreen(0.5f);
			yield return new WaitForSecondsRealtime(0.5f);
		}
		_currentLevel = levelInfo;
		TimerManager.Instance.PauseTimer.Release(this);
		CheatInputs.CanChangeLevel.Release(this);
		IsChangingLevel.SetFalse();
	}

