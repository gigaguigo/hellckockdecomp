	public bool HasBestInSlot(GearDefinition gearDefinition)
	{
		RuntimeGear gear = GetGear(gearDefinition.Slot);
		if (gear == null)
		{
			return false;
		}
		if (gearDefinition.Tier > gear.GearDefinition.Tier)
		{
			return false;
		}
		if (!gear.Rarity.IsBestRarity)
		{
			return false;
		}
		return gear.IsBestRoll;
	}

	public bool RarityHasBetterRollsAvailable(GearDefinition gearDefinition, GearRarity gearRarity)
	{
		RuntimeGear gear = GetGear(gearDefinition.Slot);
		if (gear == null)
		{
			return true;
		}
		if (gear.Rarity.IsBetterThan(gearRarity))
		{
			return false;
		}
		if (gear.Rarity == gearRarity)
		{
			return !gear.IsBestRoll;
		}
		return true;
	}

