	private IEnumerator TransitionModelsAnimation(SeasonDefinition seasonDefinition, int fromIndex, int toIndex, SeasonModel from, SeasonModel to, float fadeOutDuration, float interval, float fadeInDuration)
	{
		_isTransitioningModels = true;
		if (from != null)
		{
			from.StopParticles();
		}
		to.PlayParticles();
		if (fromIndex == -1 || toIndex == -1)
		{
			yield return TransitionBetweenTextureLerp(seasonDefinition, fromIndex, toIndex, from, to, fadeInDuration);
		}
		else
		{
			yield return TransitionBetweenModels(seasonDefinition, from, to, fadeOutDuration, interval, fadeInDuration);
		}
		_isTransitioningModels = false;
	}

	private IEnumerator TransitionBetweenTextureLerp(SeasonDefinition seasonDefinition, int fromIndex, int toIndex, SeasonModel from, SeasonModel to, float duration)
	{
		float fromRatio = ((toIndex > fromIndex) ? 0f : 1f);
		float toRatio = 1f - fromRatio;
		if (from != null)
		{
			from.SetTextureLerp(fromRatio);
			from.SetColor(seasonDefinition.SeasonColor, 0f);
		}
		to.SetTextureLerp(toRatio);
		to.SetColor(seasonDefinition.SeasonColor, 1f);
		float timer = 0f;
		while (timer < duration)
		{
			timer += Time.unscaledDeltaTime;
			float num = Mathf.Clamp01(timer / duration);
			float textureLerp = Mathf.Lerp(fromRatio, toRatio, num);
			if (from != null)
			{
				from.SetTextureLerp(textureLerp);
			}
			UpdateBillboardPosition(from, to, num);
			yield return null;
		}
		to.SetColor(seasonDefinition.SeasonColor, 0f);
		if (from != null)
		{
			from.SetColor(seasonDefinition.SeasonColor, 1f);
		}
	}

	private IEnumerator TransitionBetweenModels(SeasonDefinition seasonDefinition, SeasonModel from, SeasonModel to, float fadeOutDuration, float interval, float fadeInDuration)
	{
		if (from != null)
		{
			from.SetColor(seasonDefinition.SeasonColor, 0f);
		}
		to.SetColor(seasonDefinition.SeasonColor, 1f);
		to.SetTextureLerp(1f);
		float totalDuration = Mathf.Max(fadeOutDuration, interval + fadeInDuration);
		float timer = 0f;
		while (timer < totalDuration)
		{
			if (_hasSkipped)
			{
				yield break;
			}
			timer += Time.unscaledDeltaTime;
			float ratio = Mathf.Clamp01(timer / totalDuration);
			float fadeOut = Mathf.Clamp01(timer / fadeOutDuration);
			if (from != null)
			{
				from.SetFadeOut(fadeOut);
			}
			float fadeIn = Mathf.Clamp01((timer - interval) / fadeInDuration);
			to.SetFadeIn(fadeIn);
			UpdateBillboardPosition(from, to, ratio);
			yield return null;
		}
		if (from != null)
		{
			from.SetFadeOut(0f);
		}
		to.SetFadeIn(1f);
	}

