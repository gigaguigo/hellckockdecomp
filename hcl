	public void SelectItem(IInventoryItem item, bool blocked)
	{
		if (item == null)
		{
			return;
		}
		ClearSelection();
		for (int i = 0; i < item.Width; i++)
		{
			for (int j = 0; j < item.Height; j++)
			{
				if (item.IsPartOfShape(new Vector2Int(i, j)))
				{
					Vector2Int position = item.Position + new Vector2Int(i, j);
					if (position.x >= 0 && position.x < inventory.Width && position.y >= 0 && position.y < inventory.Height)
					{
						int cellIndex = GetCellIndex(position);
						_grids[cellIndex].color = (blocked ? _blockedCellColor : _selectedCellColor);
					}
				}
			}
		}
	}

	public void ClearSelection()
	{
		for (int i = 0; i < inventory.Height; i++)
		{
			for (int j = 0; j < inventory.Width; j++)
			{
				Vector2Int vector2Int = new Vector2Int(j, i);
				int cellIndex = GetCellIndex(vector2Int);
				_grids[cellIndex].color = GetSlotColor(vector2Int);
			}
		}
	}

