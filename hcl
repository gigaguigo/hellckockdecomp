	private IEnumerator PlayBackgroundAnimation(Color color, float offset, float duration)
	{
		_currentUpdateSequence?.Kill();
		_currentUpdateSequence = DOTween.Sequence();
		_background.color = color.WithAlpha0();
		_background.rectTransform.anchoredPosition = new Vector2(offset, 0f);
		_currentUpdateSequence.Insert(0f, _background.DOFade(color.a, duration).SetLoops(2, LoopType.Yoyo));
		_currentUpdateSequence.Insert(0f, _background.rectTransform.DOAnchorPosX(0f, duration));
		_currentUpdateSequence.Append(_background.rectTransform.DOShakeScale(duration, 0.15f));
		_currentUpdateSequence.Play();
		yield return _currentUpdateSequence.WaitForCompletion();
	}

