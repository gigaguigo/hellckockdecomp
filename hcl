	private void SetupCards(List<FoundationBlessingDeckCard> cards, List<BlessingTooltipDescriptionView> blessingsView)
	{
		for (int i = 0; i < cards.Count; i++)
		{
			FoundationBlessingDeckCard foundationBlessingDeckCard = cards[i];
			if (i >= blessingsView.Count)
			{
				blessingsView.Add(Object.Instantiate(blessingsView[0], blessingsView[0].transform.parent));
			}
			BlessingTooltipDescriptionView blessingTooltipDescriptionView = blessingsView[i];
			blessingTooltipDescriptionView.gameObject.SetActive(value: true);
			string blessingName = RosettaStone.Interpret(foundationBlessingDeckCard.FoundationBlessingCard.BlessingDefinition.TitleLocalizationKey ?? "");
			EBlessingRarity supportedRarities = foundationBlessingDeckCard.FoundationBlessingCard.BlessingDefinition.SupportedRarities;
			if (_linkedBlessingsLookup == null)
			{
