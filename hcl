		public bool Tick(float dt, int currentPage)
		{
			_timer += dt;
			float num = ((_duration <= 0f) ? 1f : Mathf.Clamp01(_timer / _duration));
			float t = Easings.QuadraticEaseOut(num);
			if (!_justWait)
			{
				Vector3 vector = Vector3.Lerp(_startPosition, _finalPosition, t);
				Vector2 sizeDelta = Vector2.Lerp(_startSize, _finalSize, t);
				if (_useAnchoredPosition)
				{
					_movedRelic.RectTransform.anchoredPosition = vector;
				}
				else
				{
					_movedRelic.transform.position = vector;
				}
				_movedRelic.RectTransform.sizeDelta = sizeDelta;
			}
			if (_originalPage != -1 && _originalPage != currentPage)
			{
				num = 1f;
			}
			if (num >= 1f)
			{
				if (_isClone)
				{
					_movedRelic.ClearValidators();
					Object.Destroy(_movedRelic.gameObject);
				}
				if (_renderer != null)
				{
					RelicInventoryItemRenderer itemRenderer = _renderer.GetItemRenderer(_item);
					if (itemRenderer != null)
					{
						itemRenderer.gameObject.SetActive(value: true);
					}
				}
				return true;
			}
			return false;
		}
	}

