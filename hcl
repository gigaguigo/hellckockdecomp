	private void SetupFoundationBlessings(ResultsData resultsData)
	{
		int num = 0;
		_foundationBlessingsContainer.gameObject.SetActive(resultsData.StatBlessings.Count > 0);
		foreach (BlessingEffect statBlessing in resultsData.StatBlessings)
		{
			if (statBlessing != null)
			{
				if (num >= _foundationBlessings.Count)
				{
					BlessingIcon blessingIcon = _foundationBlessings[0];
					BlessingIcon blessingIcon2 = Object.Instantiate(blessingIcon, blessingIcon.transform.parent, worldPositionStays: false);
					_foundationBlessings.Add(blessingIcon2);
					RegisterToBlessingEvents(blessingIcon2);
				}
				BlessingIcon blessingIcon3 = _foundationBlessings[num];
				blessingIcon3.gameObject.SetActive(value: true);
				blessingIcon3.Setup(statBlessing);
				num++;
			}
		}
		for (int i = num; i < _foundationBlessings.Count; i++)
		{
			_foundationBlessings[i].gameObject.SetActive(value: false);
		}
		LayoutRebuilder.ForceRebuildLayoutImmediate(_foundationBlessingsContainer);
	}

	private void SetupSkillBlessings(ResultsData resultsData)
	{
		int num = 0;
		foreach (KeyValuePair<SkillDefinition, List<BlessingEffect>> skillBlessing in resultsData.SkillBlessings)
		{
			SkillDefinition key = skillBlessing.Key;
			List<BlessingEffect> value = skillBlessing.Value;
			if (!(key == null) && !_hiddenSkills.Contains(key))
			{
				if (num >= _skillBlessingContainers.Count)
				{
					SkillBlessingsContainer skillBlessingsContainer = _skillBlessingContainers[0];
					SkillBlessingsContainer skillBlessingsContainer2 = Object.Instantiate(skillBlessingsContainer, skillBlessingsContainer.transform.parent, worldPositionStays: false);
					_skillBlessingContainers.Add(skillBlessingsContainer2);
					RegisterToContainerEvents(skillBlessingsContainer2);
				}
				SkillBlessingsContainer skillBlessingsContainer3 = _skillBlessingContainers[num];
				skillBlessingsContainer3.gameObject.SetActive(value: true);
				skillBlessingsContainer3.Setup(key, value);
				LayoutRebuilder.ForceRebuildLayoutImmediate((RectTransform)skillBlessingsContainer3.transform);
				num++;
