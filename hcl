		{
			List<EDevotionCategory> highestDevotionCategories = PlayerController.Instance.ConstellationsController.HighestDevotionCategories;
			if (highestDevotionCategories.Count > 0)
			{
				uniqueRelicBaseDefinition = CachedAvailableRelics.GetRandomValue(HasAffinityWith(highestDevotionCategories));
			}
		}
		if (uniqueRelicBaseDefinition == null)
		{
			uniqueRelicBaseDefinition = CachedAvailableRelics.GetRandomValue(HasRelicAvailable(result, options));
		}
		if (uniqueRelicBaseDefinition == null)
		{
