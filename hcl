	public IEventRegister<CurrencyDefinition, int> OnCollectFragment => _onCollectFragment ?? (_onCollectFragment = new EventSlot<CurrencyDefinition, int>());

	public void Setup(CurrencySaveData currencySaveData)
	{
		_currencySaveData = currencySaveData;
	}

	private void UpdateSavedData(bool saveNow = false)
	{
		PlayerSaveManager.CurrentPlayerData.currencySaveData = _currencySaveData;
		if (saveNow)
		{
			PlayerSaveManager.SaveCurrentData();
		}
	}

	public CurrencyPersistentData GetData(CurrencyDefinition currencyDefinition)
	{
		if (!_currencySaveData.TryGetDataForCurrency(currencyDefinition.HashID, out var currencyPersistentData))
		{
			return _currencySaveData.CreateDataForCurrency(currencyDefinition.HashID);
		}
		return currencyPersistentData;
	}

	public void Add(CurrencyDefinition currencyDefinition, bool isFragment, int quantity = 1)
	{
		CurrencyPersistentData data = GetData(currencyDefinition);
		if (isFragment)
		{
			AddFragmentAmount(currencyDefinition, data, quantity);
			if (data.FragmentAmount >= currencyDefinition.FragmentsToFill)
			{
				int num = Mathf.FloorToInt((float)data.FragmentAmount / (float)currencyDefinition.FragmentsToFill);
				int num2 = currencyDefinition.FragmentsToFill * num;
				AddFragmentAmount(currencyDefinition, data, -num2);
				AddAmount(currencyDefinition, data, num);
				_onCompleteFragment?.Trigger(currencyDefinition, num);
			}
		}
		else
		{
			AddAmount(currencyDefinition, data, quantity);
		}
		UpdateSavedData();
	}

	public void AddFragmentAmount(CurrencyDefinition currencyDefinition, CurrencyPersistentData saveData, int quantity)
	{
		saveData.AddFragmentAmount(quantity);
		OnAddCurrencyFragments.Trigger(currencyDefinition, quantity);
	}

	public void AddAmount(CurrencyDefinition currencyDefinition, CurrencyPersistentData saveData, int quantity)
	{
		int maxCurrency = Constants.RELIC_INVENTORY_CONFIG.MaxCurrency;
		if (saveData.Amount + quantity > maxCurrency)
		{
			quantity = maxCurrency - saveData.Amount;
		}
		saveData.AddAmount(quantity);
		OnAddCurrency.Trigger(currencyDefinition, quantity);
	}

	public void Use(CurrencyDefinition currencyDefinition)
	{
		GetData(currencyDefinition).AddAmount(-1);
		OnUseCurrency.Trigger(currencyDefinition, 1);
		UpdateSavedData(saveNow: true);
	}

	public bool HasEnoughToUse(CurrencyDefinition currencyDefinition)
	{
		return GetData(currencyDefinition).Amount > 0;
	}

	public void CollectCurrency(Prize prize)
	{
		if (prize.CurrencyPrize.HasValue)
		{
			CurrencyPrize value = prize.CurrencyPrize.Value;
			Add(value.CurrencyDefinition, value.IsFragment);
			if (!value.IsFragment)
			{
				PlayerSaveManager.Instance.PlayerSaveData.AddFlag("Obtained 1st Currency");
			}
			if (value.IsFragment)
			{
				_onCollectFragment?.Trigger(value.CurrencyDefinition, (int)prize.Amount);
			}
			else
			{
				_onCollectCurrency?.Trigger(value.CurrencyDefinition, (int)prize.Amount);
			}
		}
	}
}

