				}
				caller.StartCoroutine(previousStep.PlayCheckmarkAnimation(0.52f));
				caller.StartCoroutine(previousStep.PlayStrikethroughAnimation(0.6f));
				yield return new WaitForSeconds(0.3f);
				caller.StartCoroutine(previousStep.PlayDoneAnimation(0.4f));
				yield return new WaitForSeconds(0.15f);
				if (hasCompletedQuest)
				{
					caller.StartCoroutine(ShowStatusText(textCode, textColor));
					yield return PlayBackgroundAnimation(_completedBackgroundColor, _backgroundOutPosition, 0.4f);
				}
				else
				{
					float finalY = newStep.RectTransform.anchoredPosition.y - newStep.RectTransform.rect.height + _stepSpacing;
					caller.StartCoroutine(previousStep.PlayMoveAnimation(finalY, 0.5f));
				}
				caller.StartCoroutine(previousStep.PlayFadeOutAnimation(0.5f));
			}
