	public static void FitImageToSquare(Image icon, RectTransform parent, Vector2 sizeOverride = default(Vector2))
	{
		Sprite sprite = icon.sprite;
		if (sprite == null)
		{
			return;
		}
		Rect rect = sprite.rect;
		Vector4 border = sprite.border;
		Vector2 size = rect.size;
		float num = border.x;
		float num2 = border.z;
		float num3 = border.y;
		float num4 = border.w;
		if (num <= 0f && num2 <= 0f && num3 <= 0f && num4 == 0f)
		{
			if (size.y > size.x)
			{
				num4 = (num3 = (size.y - size.x) * 0.5f);
			}
			else
			{
				num2 = (num = (size.x - size.y) * 0.5f);
			}
		}
		float num5 = size.x - num - num2;
		float num6 = size.y - num3 - num4;
		Vector2 vector = ((sizeOverride != default(Vector2)) ? sizeOverride : parent.rect.size);
		float num7 = Mathf.Min(vector.x / num5, vector.y / num6);
		Vector2 sizeDelta = size * num7;
		float x = (num - num2) * 0.5f * num7;
		float y = (num4 - num3) * 0.5f * num7;
