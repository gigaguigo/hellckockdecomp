	{
		foreach (BlessingEffect blessingEffect in _playerController.BlessingInventory.BlessingEffects)
		{
			if (!(blessingEffect.BlessingDefinition == null))
			{
				if (blessingEffect.BlessingDefinition.EBlessingCategory == EBlessingCategory.Skill)
				{
					AddSkillBlessingToCorrespondentSkill(blessingEffect);
