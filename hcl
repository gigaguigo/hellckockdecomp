	private ConditionalEventsCollection Validator => _validator ?? (_validator = new ConditionalEventsCollection());

	public void Setup()
	{
		if (!_isInitialized)
		{
			_isInitialized = true;
			Validator.Void();
			DungeonProgressManager.Instance.IsOnHub.OnTrueState.RegisterValidated(Validator, ResetBlessedGearShop);
			PlayerSaveManager.OnSaveSelect.RegisterValidated(Validator, () =>
			{
				_blessedGearShop = null;
			});
			OnGoToHub();
		}
	}

	private void OnGoToHub()
	{
		ResetBlessedGearShop();
	}

	private void ResetBlessedGearShop()
	{
		BlessedGearShop.GenerateAvailableItems();
	}
}

