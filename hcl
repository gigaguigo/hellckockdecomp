	private async void ChangeFullScreenModeAsync()
	{
		BaseResolution selectedResolution = SelectedResolution;
		Screen.fullScreenMode = SelectedFullScreenMode;
		WaitFramesToCommitHeavyGraphicsChanges();
		await WaitToUnblock();
		int num = Resolution.Value;
		if (SelectedFullScreenMode == FullScreenMode.Windowed)
		{
			int systemWidth = SelectedMonitor.Display.systemWidth;
			int systemHeight = SelectedMonitor.Display.systemHeight;
			int num2 = 2147483647;
			if (selectedResolution.Width >= systemWidth || selectedResolution.Height >= systemHeight)
			{
				for (int i = 0; i < BaseResolutions.Count; i++)
				{
					BaseResolution baseResolution = BaseResolutions[i];
					int num3 = systemWidth - baseResolution.Width + (systemHeight - baseResolution.Height);
					if (baseResolution.Width < systemWidth && baseResolution.Height < systemHeight && num3 < num2)
					{
						num = i;
						num2 = num3;
					}
				}
			}
		}
		else if (SelectedFullScreenMode == FullScreenMode.ExclusiveFullScreen)
		{
			num = Mathf.Max(0, BaseResolutions.Count - 1);
		}
		if (Resolution.Value != num)
		{
			Resolution.Setter(num);
		}
	}

